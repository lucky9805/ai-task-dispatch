# Agent 端配置模板
# 用法：复制本文件为 agent.env，填写后运行 setup.py（或手动执行下面命令）
#   cp agent.env.example agent.env
#   python3 setup.py

# 中心地址（含 http:// 和端口；跨机器时填中心真实 IP，不是 127.0.0.1）
SERVER=http://127.0.0.1:8765

# Agent 名字（需服务端先用 ctl.py pair <名字> 登记并给你配对码）
NAME=agent-2

# 执行器：shell / echo / codex / workbuddy / claude / chatgpt
#   shell=跑任务里的 command（最通用）；echo=只回显（演示/自检最安全）
#   codex/workbuddy/claude=需本机装对应 CLI 并登录；chatgpt=需 OPENAI_API_KEY
EXECUTOR=shell

# 注意：配对码不写在这里（一次性），由 setup.py 交互输入或 --code 参数传入。
