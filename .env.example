# task-dispatch 服务端配置示例（复制为 .env 或用 export 设置）
# 零第三方依赖；bcrypt 若可用会优先用于密码哈希，缺失自动回退标准库 scrypt

# ---- 基础 ----
DISPATCH_HOST=127.0.0.1
DISPATCH_PORT=8765
DISPATCH_DB=./dispatch.db

# ---- 鉴权（生产必配，勿空）----
# 供 ctl.py / submit.py 脚本调用的管理令牌；留空则依赖首次启动生成的管理员账号登录
DISPATCH_TOKEN=please-generate-a-long-random-token

# ---- 安全策略 ----
DISPATCH_LEASE=120
DISPATCH_ONLINE_WINDOW=30
DISPATCH_PAIR_TTL=600

# ---- TLS（内置 HTTPS，可选；也可走反向代理）----
# DISPATCH_TLS_CERT=/path/to/server.crt
# DISPATCH_TLS_KEY=/path/to/server.key

# 生产启动示例：
#   export DISPATCH_TOKEN="$(python3 -c 'import secrets;print(secrets.token_urlsafe(32))')"
#   python3 server.py --host 0.0.0.0 --port 8765 --allow-cidr 192.168.8.0/24
# 首次启动会打印初始管理员账号密码，登录 Web 后立即修改。
